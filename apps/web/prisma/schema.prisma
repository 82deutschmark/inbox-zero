generator client {
  provider               = "prisma-client"
  output                 = "../generated/prisma"
  generatedFileExtension = "ts"
  importFileExtension    = "ts"
}

datasource db {
  provider = "postgresql"
}

model Account {
  id                    String        @id
  createdAt             DateTime      @default(now())
  updatedAt             DateTime
  userId                String
  type                  String        @default("oidc")
  provider              String
  providerAccountId     String
  refresh_token         String?
  access_token          String?
  expires_at            DateTime?     @default(now())
  token_type            String?
  scope                 String?
  id_token              String?
  session_state         String?
  refreshTokenExpiresAt DateTime?
  disconnectedAt        DateTime?
  User                  User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  EmailAccount          EmailAccount?

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Action {
  id             String     @id
  createdAt      DateTime   @default(now())
  updatedAt      DateTime
  type           ActionType
  ruleId         String
  label          String?
  subject        String?
  content        String?
  to             String?
  cc             String?
  bcc            String?
  url            String?
  delayInMinutes Int?
  folderName     String?
  folderId       String?
  labelId        String?
  Rule           Rule       @relation(fields: [ruleId], references: [id], onDelete: Cascade)

  @@index([ruleId])
}

model ApiKey {
  id        String   @id
  createdAt DateTime @default(now())
  updatedAt DateTime
  name      String?
  hashedKey String   @unique
  isActive  Boolean  @default(true)
  userId    String
  User      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isActive])
}

model Calendar {
  id                 String             @id
  createdAt          DateTime           @default(now())
  updatedAt          DateTime
  calendarId         String
  name               String
  description        String?
  primary            Boolean            @default(false)
  isEnabled          Boolean            @default(true)
  timezone           String?
  connectionId       String
  CalendarConnection CalendarConnection @relation(fields: [connectionId], references: [id], onDelete: Cascade)

  @@unique([connectionId, calendarId])
}

model CalendarConnection {
  id             String       @id
  createdAt      DateTime     @default(now())
  updatedAt      DateTime
  provider       String
  email          String
  accessToken    String?
  refreshToken   String?
  expiresAt      DateTime?
  isConnected    Boolean      @default(true)
  emailAccountId String
  Calendar       Calendar[]
  EmailAccount   EmailAccount @relation(fields: [emailAccountId], references: [id], onDelete: Cascade)

  @@unique([emailAccountId, provider, email])
}

model Category {
  id             String       @id
  createdAt      DateTime     @default(now())
  updatedAt      DateTime
  name           String
  description    String?
  emailAccountId String
  EmailAccount   EmailAccount @relation(fields: [emailAccountId], references: [id], onDelete: Cascade)
  Newsletter     Newsletter[]
  Rule           Rule[]

  @@unique([name, emailAccountId])
}

model Chat {
  id             String        @id
  createdAt      DateTime      @default(now())
  updatedAt      DateTime
  emailAccountId String
  EmailAccount   EmailAccount  @relation(fields: [emailAccountId], references: [id], onDelete: Cascade)
  ChatMessage    ChatMessage[]

  @@index([emailAccountId])
}

model ChatMessage {
  id        String   @id
  createdAt DateTime @default(now())
  updatedAt DateTime
  role      String
  chatId    String
  parts     Json
  Chat      Chat     @relation(fields: [chatId], references: [id], onDelete: Cascade)

  @@index([chatId])
}

model CleanupJob {
  id               String          @id
  createdAt        DateTime        @default(now())
  updatedAt        DateTime
  action           CleanAction     @default(ARCHIVE)
  daysOld          Int             @default(7)
  instructions     String?
  skipAttachment   Boolean?
  skipCalendar     Boolean?
  skipReceipt      Boolean?
  skipReply        Boolean?
  skipStarred      Boolean?
  skipConversation Boolean?
  emailAccountId   String
  EmailAccount     EmailAccount    @relation(fields: [emailAccountId], references: [id], onDelete: Cascade)
  CleanupThread    CleanupThread[]

  @@index([emailAccountId])
}

model CleanupThread {
  id             String       @id
  createdAt      DateTime     @default(now())
  updatedAt      DateTime
  threadId       String
  archived       Boolean
  jobId          String
  emailAccountId String
  EmailAccount   EmailAccount @relation(fields: [emailAccountId], references: [id], onDelete: Cascade)
  CleanupJob     CleanupJob   @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@index([jobId])
}

model ColdEmail {
  id             String           @id
  createdAt      DateTime         @default(now())
  updatedAt      DateTime
  fromEmail      String
  messageId      String?
  threadId       String?
  status         ColdEmailStatus?
  reason         String?
  emailAccountId String
  EmailAccount   EmailAccount     @relation(fields: [emailAccountId], references: [id], onDelete: Cascade)
  DigestItem     DigestItem[]

  @@unique([emailAccountId, fromEmail])
  @@index([emailAccountId, createdAt])
  @@index([emailAccountId, status])
}

model Digest {
  id             String       @id
  createdAt      DateTime     @default(now())
  updatedAt      DateTime
  emailAccountId String
  sentAt         DateTime?
  status         DigestStatus @default(PENDING)
  EmailAccount   EmailAccount @relation(fields: [emailAccountId], references: [id], onDelete: Cascade)
  DigestItem     DigestItem[]

  @@index([emailAccountId])
}

model DigestItem {
  id             String          @id
  createdAt      DateTime        @default(now())
  updatedAt      DateTime
  messageId      String
  threadId       String
  content        String
  digestId       String
  actionId       String?
  coldEmailId    String?
  ExecutedAction ExecutedAction? @relation(fields: [actionId], references: [id], onDelete: Cascade)
  ColdEmail      ColdEmail?      @relation(fields: [coldEmailId], references: [id])
  Digest         Digest          @relation(fields: [digestId], references: [id], onDelete: Cascade)

  @@unique([digestId, threadId, messageId])
  @@index([actionId])
  @@index([coldEmailId])
}

model DocumentFiling {
  id                    String               @id
  createdAt             DateTime             @default(now())
  updatedAt             DateTime
  messageId             String
  attachmentId          String
  filename              String
  folderId              String?
  folderPath            String
  fileId                String?
  reasoning             String?
  confidence            Float?
  status                DocumentFilingStatus @default(FILED)
  wasAsked              Boolean              @default(false)
  wasCorrected          Boolean              @default(false)
  originalPath          String?
  correctedAt           DateTime?
  notificationMessageId String?              @unique
  notificationSentAt    DateTime?
  driveConnectionId     String
  emailAccountId        String
  feedbackAt            DateTime?
  feedbackPositive      Boolean?
  DriveConnection       DriveConnection      @relation(fields: [driveConnectionId], references: [id], onDelete: Cascade)
  EmailAccount          EmailAccount         @relation(fields: [emailAccountId], references: [id], onDelete: Cascade)

  @@index([driveConnectionId])
  @@index([emailAccountId, status])
  @@index([messageId])
}

model DraftSendLog {
  id               String         @id
  createdAt        DateTime       @default(now())
  executedActionId String         @unique
  sentMessageId    String
  similarityScore  Float
  ExecutedAction   ExecutedAction @relation(fields: [executedActionId], references: [id], onDelete: Cascade)

  @@index([executedActionId])
}

model DriveConnection {
  id             String           @id
  createdAt      DateTime         @default(now())
  updatedAt      DateTime
  provider       String
  email          String
  accessToken    String?
  refreshToken   String?
  expiresAt      DateTime?
  isConnected    Boolean          @default(true)
  emailAccountId String
  DocumentFiling DocumentFiling[]
  EmailAccount   EmailAccount     @relation(fields: [emailAccountId], references: [id], onDelete: Cascade)
  FilingFolder   FilingFolder[]

  @@unique([emailAccountId, provider])
  @@index([emailAccountId])
}

model EmailAccount {
  createdAt                      DateTime             @default(now())
  updatedAt                      DateTime
  email                          String               @unique
  writingStyle                   String?
  userId                         String
  accountId                      String               @unique
  about                          String?
  autoCategorizeSenders          Boolean              @default(false)
  behaviorProfile                Json?
  coldEmailBlocker               ColdEmailSetting?
  coldEmailPrompt                String?
  lastSummaryEmailAt             DateTime?
  lastSyncedHistoryId            String?
  rulesPrompt                    String?
  signature                      String?
  statsEmailFrequency            Frequency            @default(WEEKLY)
  summaryEmailFrequency          Frequency            @default(WEEKLY)
  watchEmailsExpirationDate      DateTime?
  id                             String               @id
  image                          String?
  name                           String?
  watchEmailsSubscriptionId      String?
  coldEmailDigest                Boolean              @default(false)
  personaAnalysis                Json?
  role                           String?
  includeReferralSignature       Boolean              @default(false)
  multiRuleSelectionEnabled      Boolean              @default(false)
  watchEmailsSubscriptionHistory Json?
  timezone                       String?
  calendarBookingLink            String?
  meetingBriefingsEnabled        Boolean              @default(false)
  meetingBriefingsMinutesBefore  Int                  @default(240)
  filingEnabled                  Boolean              @default(false)
  filingPrompt                   String?
  followUpAwaitingReplyDays      Float?
  followUpNeedsReplyDays         Float?
  followUpAutoDraftEnabled       Boolean              @default(true)
  CalendarConnection             CalendarConnection[]
  Category                       Category[]
  Chat                           Chat[]
  CleanupJob                     CleanupJob[]
  CleanupThread                  CleanupThread[]
  ColdEmail                      ColdEmail[]
  Digest                         Digest[]
  DocumentFiling                 DocumentFiling[]
  DriveConnection                DriveConnection[]
  Account                        Account              @relation(fields: [accountId], references: [id], onDelete: Cascade)
  User                           User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  EmailMessage                   EmailMessage[]
  EmailToken                     EmailToken[]
  ExecutedRule                   ExecutedRule[]
  FilingFolder                   FilingFolder[]
  Group                          Group[]
  Knowledge                      Knowledge[]
  Label                          Label[]
  McpConnection                  McpConnection[]
  MeetingBriefing                MeetingBriefing[]
  Member                         Member[]
  Newsletter                     Newsletter[]
  ResponseTime                   ResponseTime[]
  Rule                           Rule[]
  Schedule                       Schedule?
  ScheduledAction                ScheduledAction[]
  ThreadTracker                  ThreadTracker[]
  invitation                     invitation[]
  ssoProvider                    ssoProvider[]

  @@index([lastSummaryEmailAt])
  @@index([userId])
}

model EmailMessage {
  id              String       @id
  createdAt       DateTime     @default(now())
  updatedAt       DateTime
  threadId        String
  messageId       String
  date            DateTime
  from            String
  fromDomain      String
  to              String
  unsubscribeLink String?
  read            Boolean
  sent            Boolean
  draft           Boolean
  inbox           Boolean
  emailAccountId  String
  fromName        String?
  EmailAccount    EmailAccount @relation(fields: [emailAccountId], references: [id], onDelete: Cascade)

  @@unique([emailAccountId, threadId, messageId])
  @@index([emailAccountId, date])
  @@index([emailAccountId, fromName])
  @@index([emailAccountId, from])
  @@index([emailAccountId, threadId])
}

model EmailToken {
  id             String       @id
  createdAt      DateTime     @default(now())
  token          String       @unique
  expiresAt      DateTime
  emailAccountId String
  EmailAccount   EmailAccount @relation(fields: [emailAccountId], references: [id], onDelete: Cascade)

  @@index([emailAccountId])
}

model ExecutedAction {
  id              String           @id
  createdAt       DateTime         @default(now())
  updatedAt       DateTime
  type            ActionType
  executedRuleId  String
  label           String?
  subject         String?
  content         String?
  to              String?
  cc              String?
  bcc             String?
  url             String?
  draftId         String?
  wasDraftSent    Boolean?
  folderName      String?
  folderId        String?
  labelId         String?
  DigestItem      DigestItem[]
  DraftSendLog    DraftSendLog?
  ExecutedRule    ExecutedRule     @relation(fields: [executedRuleId], references: [id], onDelete: Cascade)
  ScheduledAction ScheduledAction?

  @@index([executedRuleId])
}

model ExecutedRule {
  id              String             @id
  createdAt       DateTime           @default(now())
  updatedAt       DateTime
  threadId        String
  messageId       String
  automated       Boolean
  ruleId          String?
  reason          String?
  status          ExecutedRuleStatus
  emailAccountId  String
  matchMetadata   Json?
  ExecutedAction  ExecutedAction[]
  EmailAccount    EmailAccount       @relation(fields: [emailAccountId], references: [id], onDelete: Cascade)
  Rule            Rule?              @relation(fields: [ruleId], references: [id])
  ScheduledAction ScheduledAction[]

  @@index([emailAccountId, messageId])
  @@index([emailAccountId, status, createdAt])
  @@index([emailAccountId, threadId, messageId, ruleId])
}

model FilingFolder {
  id                String          @id
  createdAt         DateTime        @default(now())
  updatedAt         DateTime
  folderId          String
  folderName        String
  folderPath        String
  driveConnectionId String
  emailAccountId    String
  DriveConnection   DriveConnection @relation(fields: [driveConnectionId], references: [id], onDelete: Cascade)
  EmailAccount      EmailAccount    @relation(fields: [emailAccountId], references: [id], onDelete: Cascade)

  @@unique([emailAccountId, folderId])
  @@index([driveConnectionId])
}

model Group {
  id             String       @id
  createdAt      DateTime     @default(now())
  updatedAt      DateTime
  name           String
  prompt         String?
  emailAccountId String
  EmailAccount   EmailAccount @relation(fields: [emailAccountId], references: [id], onDelete: Cascade)
  GroupItem      GroupItem[]
  Rule           Rule?

  @@unique([name, emailAccountId])
}

model GroupItem {
  id        String           @id
  createdAt DateTime         @default(now())
  updatedAt DateTime
  groupId   String?
  type      GroupItemType
  value     String
  exclude   Boolean          @default(false)
  messageId String?
  reason    String?
  source    GroupItemSource?
  threadId  String?
  Group     Group?           @relation(fields: [groupId], references: [id], onDelete: Cascade)

  @@unique([groupId, type, value])
}

model Knowledge {
  id             String       @id
  createdAt      DateTime     @default(now())
  updatedAt      DateTime
  title          String
  content        String
  emailAccountId String
  EmailAccount   EmailAccount @relation(fields: [emailAccountId], references: [id], onDelete: Cascade)

  @@unique([emailAccountId, title])
}

model Label {
  id             String       @id
  createdAt      DateTime     @default(now())
  updatedAt      DateTime
  gmailLabelId   String
  name           String
  description    String?
  enabled        Boolean      @default(true)
  emailAccountId String
  EmailAccount   EmailAccount @relation(fields: [emailAccountId], references: [id], onDelete: Cascade)

  @@unique([gmailLabelId, emailAccountId])
  @@unique([name, emailAccountId])
}

model McpConnection {
  id             String         @id
  createdAt      DateTime       @default(now())
  updatedAt      DateTime
  name           String
  isActive       Boolean        @default(true)
  accessToken    String?
  refreshToken   String?
  apiKey         String?
  expiresAt      DateTime?
  integrationId  String
  emailAccountId String?
  EmailAccount   EmailAccount?  @relation(fields: [emailAccountId], references: [id], onDelete: Cascade)
  McpIntegration McpIntegration @relation(fields: [integrationId], references: [id], onDelete: Cascade)
  McpTool        McpTool[]

  @@unique([emailAccountId, integrationId])
}

model McpIntegration {
  id                         String          @id
  createdAt                  DateTime        @default(now())
  updatedAt                  DateTime
  name                       String          @unique
  registeredServerUrl        String?
  registeredAuthorizationUrl String?
  registeredTokenUrl         String?
  oauthClientId              String?
  oauthClientSecret          String?
  McpConnection              McpConnection[]
}

model McpTool {
  id            String        @id
  createdAt     DateTime      @default(now())
  updatedAt     DateTime
  name          String
  description   String?
  schema        Json?
  isEnabled     Boolean       @default(true)
  connectionId  String
  McpConnection McpConnection @relation(fields: [connectionId], references: [id], onDelete: Cascade)

  @@unique([connectionId, name])
}

model MeetingBriefing {
  id              String                @id
  createdAt       DateTime              @default(now())
  calendarEventId String
  eventTitle      String
  eventStartTime  DateTime
  guestCount      Int
  status          MeetingBriefingStatus
  emailAccountId  String
  EmailAccount    EmailAccount          @relation(fields: [emailAccountId], references: [id], onDelete: Cascade)

  @@unique([emailAccountId, calendarEventId])
  @@index([emailAccountId])
}

model Member {
  id             String       @id
  organizationId String
  role           String       @default("member")
  createdAt      DateTime     @default(now())
  updatedAt      DateTime
  emailAccountId String
  EmailAccount   EmailAccount @relation(fields: [emailAccountId], references: [id], onDelete: Cascade)
  Organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, emailAccountId])
  @@index([emailAccountId])
}

model Newsletter {
  id              String            @id
  createdAt       DateTime          @default(now())
  updatedAt       DateTime
  email           String
  status          NewsletterStatus?
  categoryId      String?
  lastAnalyzedAt  DateTime?
  patternAnalyzed Boolean           @default(false)
  emailAccountId  String
  name            String?
  Category        Category?         @relation(fields: [categoryId], references: [id])
  EmailAccount    EmailAccount      @relation(fields: [emailAccountId], references: [id], onDelete: Cascade)

  @@unique([email, emailAccountId])
  @@index([categoryId])
  @@index([emailAccountId, status])
}

model Organization {
  id          String        @id
  name        String
  slug        String        @unique
  logo        String?
  metadata    Json?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime
  Member      Member[]
  Session     Session[]
  invitation  invitation[]
  ssoProvider ssoProvider[]
}

model Payment {
  id                      String        @id
  createdAt               DateTime
  updatedAt               DateTime
  premiumId               String?
  processorId             String?       @unique
  processorSubscriptionId String?
  processorCustomerId     String?
  amount                  Int
  currency                String
  status                  String
  refunded                Boolean       @default(false)
  refundedAt              DateTime?
  refundedAmount          Int?
  billingReason           String?
  processorType           ProcessorType @default(LEMON_SQUEEZY)
  tax                     Int
  taxInclusive            Boolean
  Premium                 Premium?      @relation(fields: [premiumId], references: [id])

  @@index([premiumId])
}

model Premium {
  id                                String       @id
  createdAt                         DateTime     @default(now())
  updatedAt                         DateTime
  lemonSqueezyRenewsAt              DateTime?
  lemonSqueezyCustomerId            Int?
  lemonSqueezySubscriptionId        Int?
  lemonSqueezySubscriptionItemId    Int?
  lemonSqueezyOrderId               Int?
  lemonSqueezyProductId             Int?
  lemonSqueezyVariantId             Int?
  tier                              PremiumTier?
  emailAccountsAccess               Int?
  unsubscribeMonth                  Int?
  unsubscribeCredits                Int?
  aiMonth                           Int?
  aiCredits                         Int?
  lemonLicenseInstanceId            String?
  lemonLicenseKey                   String?
  pendingInvites                    String[]
  lemonSubscriptionStatus           String?
  stripeCancelAtPeriodEnd           Boolean?
  stripeCanceledAt                  DateTime?
  stripeCustomerId                  String?      @unique
  stripeEndedAt                     DateTime?
  stripePriceId                     String?
  stripeProductId                   String?
  stripeRenewsAt                    DateTime?
  stripeSubscriptionId              String?      @unique
  stripeSubscriptionItemId          String?      @unique
  stripeSubscriptionStatus          String?
  stripeTrialEnd                    DateTime?
  Payment                           Payment[]
  User_User_premiumAdminIdToPremium User[]       @relation("User_premiumAdminIdToPremium")
  User_User_premiumIdToPremium      User[]       @relation("User_premiumIdToPremium")

  @@index([pendingInvites])
}

model Referral {
  id                                 String         @id
  createdAt                          DateTime       @default(now())
  updatedAt                          DateTime
  referrerUserId                     String
  referredUserId                     String         @unique
  referralCodeUsed                   String
  status                             ReferralStatus @default(PENDING)
  rewardGrantedAt                    DateTime?
  stripeBalanceTransactionId         String?
  rewardAmount                       Int?
  User_Referral_referredUserIdToUser User           @relation("Referral_referredUserIdToUser", fields: [referredUserId], references: [id], onDelete: Cascade)
  User_Referral_referrerUserIdToUser User           @relation("Referral_referrerUserIdToUser", fields: [referrerUserId], references: [id], onDelete: Cascade)

  @@index([referrerUserId])
  @@index([status])
}

model ResponseTime {
  id                String       @id
  createdAt         DateTime     @default(now())
  threadId          String
  sentMessageId     String
  receivedMessageId String
  responseTimeMins  Int
  receivedAt        DateTime
  sentAt            DateTime
  emailAccountId    String
  EmailAccount      EmailAccount @relation(fields: [emailAccountId], references: [id], onDelete: Cascade)

  @@unique([emailAccountId, sentMessageId])
  @@index([emailAccountId, sentAt])
}

model Rule {
  id                  String              @id
  createdAt           DateTime            @default(now())
  updatedAt           DateTime
  instructions        String?
  automate            Boolean             @default(true)
  name                String
  runOnThreads        Boolean             @default(false)
  body                String?
  from                String?
  groupId             String?             @unique
  subject             String?
  to                  String?
  enabled             Boolean             @default(true)
  categoryFilterType  CategoryFilterType?
  conditionalOperator LogicalOperator     @default(AND)
  systemType          SystemType?
  emailAccountId      String
  promptText          String?
  Action              Action[]
  ExecutedRule        ExecutedRule[]
  EmailAccount        EmailAccount        @relation(fields: [emailAccountId], references: [id], onDelete: Cascade)
  Group               Group?              @relation(fields: [groupId], references: [id], onDelete: Cascade)
  RuleHistory         RuleHistory[]
  Category            Category[]

  @@unique([emailAccountId, systemType])
  @@unique([name, emailAccountId])
}

model RuleHistory {
  id                  String   @id
  createdAt           DateTime @default(now())
  ruleId              String
  version             Int
  triggerType         String
  promptText          String?
  name                String
  instructions        String?
  enabled             Boolean
  automate            Boolean
  runOnThreads        Boolean
  conditionalOperator String
  from                String?
  to                  String?
  subject             String?
  body                String?
  categoryFilterType  String?
  systemType          String?
  actions             Json
  categoryFilters     Json?
  Rule                Rule     @relation(fields: [ruleId], references: [id], onDelete: Cascade)

  @@unique([ruleId, version])
  @@index([ruleId, createdAt])
}

model Schedule {
  id               String       @id
  createdAt        DateTime     @default(now())
  updatedAt        DateTime
  intervalDays     Int?
  occurrences      Int?
  daysOfWeek       Int?
  timeOfDay        DateTime?
  emailAccountId   String       @unique
  lastOccurrenceAt DateTime?
  nextOccurrenceAt DateTime?
  EmailAccount     EmailAccount @relation(fields: [emailAccountId], references: [id], onDelete: Cascade)
}

model ScheduledAction {
  id               String                @id
  createdAt        DateTime              @default(now())
  updatedAt        DateTime
  executedRuleId   String
  actionType       ActionType
  messageId        String
  threadId         String
  scheduledFor     DateTime
  emailAccountId   String
  status           ScheduledActionStatus @default(PENDING)
  schedulingStatus SchedulingStatus      @default(PENDING)
  label            String?
  subject          String?
  content          String?
  to               String?
  cc               String?
  bcc              String?
  url              String?
  scheduledId      String?
  executedAt       DateTime?
  executedActionId String?               @unique
  folderName       String?
  folderId         String?
  labelId          String?
  EmailAccount     EmailAccount          @relation(fields: [emailAccountId], references: [id], onDelete: Cascade)
  ExecutedAction   ExecutedAction?       @relation(fields: [executedActionId], references: [id], onDelete: Cascade)
  ExecutedRule     ExecutedRule          @relation(fields: [executedRuleId], references: [id], onDelete: Cascade)

  @@index([emailAccountId, messageId])
  @@index([executedRuleId])
  @@index([status, scheduledFor])
}

model Session {
  id                   String        @id
  sessionToken         String        @unique
  userId               String
  expires              DateTime
  ipAddress            String?
  userAgent            String?
  createdAt            DateTime      @default(now())
  updatedAt            DateTime
  activeOrganizationId String?
  Organization         Organization? @relation(fields: [activeOrganizationId], references: [id])
  User                 User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([activeOrganizationId])
  @@index([userId])
}

model ThreadTracker {
  id                String            @id
  createdAt         DateTime          @default(now())
  updatedAt         DateTime
  threadId          String
  messageId         String
  resolved          Boolean           @default(false)
  type              ThreadTrackerType
  sentAt            DateTime
  emailAccountId    String
  followUpAppliedAt DateTime?
  EmailAccount      EmailAccount      @relation(fields: [emailAccountId], references: [id], onDelete: Cascade)

  @@unique([emailAccountId, threadId, messageId])
  @@index([emailAccountId, resolved])
  @@index([emailAccountId, resolved, sentAt, type])
  @@index([emailAccountId, type, resolved, followUpAppliedAt, sentAt], map: "ThreadTracker_emailAccountId_type_resolved_followUpAppliedAt_id")
  @@index([emailAccountId, type, resolved, sentAt])
}

model User {
  id                                     String         @id
  createdAt                              DateTime       @default(now())
  updatedAt                              DateTime
  name                                   String?
  email                                  String         @unique
  emailVerified                          Boolean?       @default(false)
  image                                  String?
  aiModel                                String?
  aiApiKey                               String?
  premiumId                              String?
  onboardingAnswers                      Json?
  aiProvider                             String?
  lastLogin                              DateTime?
  utms                                   Json?
  premiumAdminId                         String?
  errorMessages                          Json?
  completedAppOnboardingAt               DateTime?
  completedOnboardingAt                  DateTime?
  webhookSecret                          String?
  surveyFeatures                         String[]
  surveyGoal                             String?
  surveyImprovements                     String?
  surveyRole                             String?
  surveySource                           String?
  referralCode                           String?        @unique
  surveyCompanySize                      Int?
  Account                                Account[]
  ApiKey                                 ApiKey[]
  EmailAccount                           EmailAccount[]
  Referral_Referral_referredUserIdToUser Referral?      @relation("Referral_referredUserIdToUser")
  Referral_Referral_referrerUserIdToUser Referral[]     @relation("Referral_referrerUserIdToUser")
  Session                                Session[]
  Premium_User_premiumAdminIdToPremium   Premium?       @relation("User_premiumAdminIdToPremium", fields: [premiumAdminId], references: [id])
  Premium_User_premiumIdToPremium        Premium?       @relation("User_premiumIdToPremium", fields: [premiumId], references: [id])
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime
  id         String   @id
  createdAt  DateTime @default(now())
  updatedAt  DateTime

  @@unique([identifier, token])
}

model invitation {
  id             String       @id
  organizationId String
  email          String
  role           String?
  status         String
  expiresAt      DateTime
  inviterId      String
  EmailAccount   EmailAccount @relation(fields: [inviterId], references: [id], onDelete: Cascade)
  Organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([inviterId])
  @@index([organizationId])
}

model ssoProvider {
  id             String        @id
  issuer         String
  oidcConfig     String?
  samlConfig     String?
  providerId     String        @unique
  organizationId String?
  domain         String
  emailAccountId String?
  EmailAccount   EmailAccount? @relation(fields: [emailAccountId], references: [id], onDelete: Cascade)
  Organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([emailAccountId])
  @@index([organizationId])
}

model verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @default(now())
}

